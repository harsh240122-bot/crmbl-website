# Copy this file to .env and change the values
PORT=3000
ADMIN_PASSWORD=choose-a-strong-password
SESSION_SECRET=paste-a-long-random-string-here
NODE_ENV=production
# Set to 1 when running behind a proxy/load balancer (Render, Railway, Nginx)
TRUST_PROXY=1
# Force JSON file storage instead of SQLite (optional)
# STORAGE=json

# ---- New-order alerts on your phone (pick one or both) ----
# ntfy: install the free "ntfy" app, tap +, subscribe to the same topic name as below
NTFY_TOPIC=crmbl-orders-change-this-to-something-random
# NTFY_SERVER=https://ntfy.sh
# Telegram: create a bot with @BotFather, send it a message, then put the token + your chat id here
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Your website address, so tapping the alert opens the dashboard
# PUBLIC_URL=https://crmbl.onrender.com

# ---- Optional: live Google Sheet of orders (see google-sheets-script.gs) ----
# SHEETS_WEBHOOK_URL=
# SHEETS_SECRET=

# First order number will be ORDER_START + 1 (default 1000 → #1001)
# ORDER_START=1000
